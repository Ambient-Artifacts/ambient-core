{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 10
    },
    "type": {
      "type": "string",
      "const": "note"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": [
        "meeting",
        "call",
        "memo",
        "idea",
        "lecture",
        "other",
        "session"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "duration_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "team"
      ]
    },
    "team_id": {
      "type": "string"
    },
    "recorded_by": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]*$"
    },
    "consent": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "all-agreed",
            "announced",
            "solo",
            "unknown"
          ]
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "mode"
      ]
    },
    "people": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9/_-]*$"
      }
    },
    "orgs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9/_-]*$"
      }
    },
    "projects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9/_-]*$"
      }
    },
    "topics": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9/_-]*$"
      }
    },
    "raw": {
      "type": "string"
    },
    "work": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "repo": {
          "type": "string",
          "maxLength": 200
        },
        "branch": {
          "type": "string",
          "maxLength": 120
        },
        "ended_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "tool"
      ]
    },
    "compile": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "fm-ondevice",
            "fm-pcc",
            "server"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "compiled",
            "partial",
            "failed"
          ]
        },
        "fallback": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "extractive"
          ]
        }
      },
      "required": [
        "engine",
        "status"
      ]
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "summary",
    "kind",
    "recorded_at",
    "duration_s",
    "language",
    "scope",
    "consent",
    "updated"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "brain.team-note/v1"
    },
    "note_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_-]{10,64}$"
    },
    "team_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_by": {
      "type": "string",
      "minLength": 1
    },
    "recorded_by_name": {
      "type": "string",
      "maxLength": 80
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "duration_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "kind": {
      "type": "string",
      "enum": [
        "meeting",
        "call",
        "memo",
        "idea",
        "lecture",
        "other",
        "session"
      ]
    },
    "consent": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "all-agreed",
            "announced",
            "solo"
          ]
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "mode",
        "confirmed_at"
      ]
    },
    "entry_page": {
      "type": "object",
      "properties": {
        "frontmatter": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "body_md": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "frontmatter",
        "body_md"
      ]
    },
    "transcript": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "segments": {
              "maxItems": 20000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "t0": {
                    "type": "number"
                  },
                  "t1": {
                    "type": "number"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "speaker": {
                    "type": "string",
                    "maxLength": 80
                  }
                },
                "required": [
                  "t0",
                  "t1",
                  "text"
                ]
              }
            }
          },
          "required": [
            "segments"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "participants_hint": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "client": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "maxLength": 200
        },
        "transcriber": {
          "type": "string",
          "maxLength": 200
        },
        "compiler": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "app",
        "transcriber",
        "compiler"
      ]
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "meeting": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "attendees": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "required": [
        "title"
      ]
    },
    "speakers": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    }
  },
  "required": [
    "schema",
    "note_id",
    "team_id",
    "recorded_by",
    "recorded_at",
    "duration_s",
    "language",
    "kind",
    "consent",
    "entry_page",
    "transcript",
    "client"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "person",
        "org",
        "project",
        "topic"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "update_mode": {
      "type": "string",
      "const": "compiled"
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "outdated"
      ]
    },
    "links": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9/_-]*$"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9/_-]*$"
            }
          }
        ]
      }
    },
    "compiled_through": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "review": {
      "type": "string",
      "enum": [
        "auto",
        "required"
      ]
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "title",
    "type",
    "summary",
    "update_mode",
    "updated"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "decision"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "accepted",
        "superseded"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "deciders": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9/_-]*$"
      }
    },
    "affects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9/_-]*$"
      }
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]*$"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]*$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "title",
    "type",
    "summary",
    "status",
    "date",
    "updated"
  ]
}

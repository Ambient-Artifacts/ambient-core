{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "ops": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "upsert"
              },
              "path": {
                "type": "string",
                "pattern": "^(wiki\\/[a-z0-9][a-z0-9/_.-]*|raw\\/\\d{4}\\/\\d{2}\\/[0-9A-Za-z_-]+)\\.md$"
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "content": {
                "type": "string",
                "maxLength": 600000
              },
              "updated": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "op",
              "path",
              "hash",
              "content",
              "updated"
            ]
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "delete"
              },
              "path": {
                "type": "string",
                "pattern": "^(wiki\\/[a-z0-9][a-z0-9/_.-]*|raw\\/\\d{4}\\/\\d{2}\\/[0-9A-Za-z_-]+)\\.md$"
              }
            },
            "required": [
              "op",
              "path"
            ]
          }
        ]
      }
    },
    "since_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "device_id",
    "ops"
  ]
}

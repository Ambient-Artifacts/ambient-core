{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "transcripts": {
      "default": {
        "kind": "repo",
        "folder": "raw"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "repo"
            },
            "folder": {
              "default": "raw",
              "type": "string",
              "const": "raw"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "drive"
            },
            "drive_id": {
              "type": "string",
              "minLength": 5,
              "maxLength": 300
            },
            "folder_id": {
              "type": "string",
              "minLength": 5,
              "maxLength": 300
            },
            "label": {
              "default": "",
              "type": "string",
              "maxLength": 300
            }
          },
          "required": [
            "kind",
            "drive_id",
            "folder_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "work": {
      "default": {
        "kind": "none"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "drive"
            },
            "drive_id": {
              "type": "string",
              "minLength": 5,
              "maxLength": 300
            },
            "folder_id": {
              "type": "string",
              "minLength": 5,
              "maxLength": 300
            },
            "label": {
              "default": "",
              "type": "string",
              "maxLength": 300
            }
          },
          "required": [
            "kind",
            "drive_id",
            "folder_id"
          ]
        }
      ]
    },
    "microsoft": {
      "default": null,
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "own"
                },
                "tenant_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "client_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "client_secret": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 300
                }
              },
              "required": [
                "kind",
                "tenant_id",
                "client_id",
                "client_secret"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "ambient"
                },
                "tenant_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "tenant_name": {
                  "default": "",
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "kind",
                "tenant_id"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

# Settings for docker-compose.yml. ops/docker/init.sh writes .env from this with fresh secrets;
# to do it by hand, copy it to .env and fill in the first block (docs/self-hosting.md).
# Back .env up: losing BRAIN_MASTER_KEY makes every stored personal note unreadable.

# ---- Required (init.sh fills these in) ----
# The public name of this server; Caddy gets its HTTPS certificate for it.
BRAIN_DOMAIN=ambient.example.com
# The URL people and AI apps use. Also the issuer of every token: don't change it later.
BRAIN_ORIGIN=https://ambient.example.com
# "caddy" serves HTTPS on ports 80/443. Empty: bring your own reverse proxy to 127.0.0.1:8080.
COMPOSE_PROFILES=caddy
# From `node ops/gen-secrets.mjs --env` (or `docker run --rm ambient-platform:local node ops/gen-secrets.mjs --env`).
BRAIN_SIGNING_JWKS=
BRAIN_COOKIE_KEYS=
BRAIN_MASTER_KEY_ID=mk1
BRAIN_MASTER_KEY=
BRAIN_SERVICE_SECRET=
# From `docker compose exec convex ./generate_admin_key.sh`. Single quotes: it contains "|".
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ---- Optional ----
# Claude (Anthropic API key): writes notes from work sessions, keeps personal wikis current for
# users who opted in, and consolidates the team wiki every night. Without one, everything else works.
ANTHROPIC_API_KEY=
# A separate key (and spend limit) for the team server; defaults to ANTHROPIC_API_KEY.
TEAM_ANTHROPIC_API_KEY=
# Models (defaults: Claude Haiku).
BRAIN_SESSION_MODEL=
BRAIN_CONSOLIDATE_MODEL=
# When the team wiki's nightly consolidation runs, in TZ.
BRAIN_CONSOLIDATE_AT=02:00
TZ=UTC
# A Slack-compatible incoming webhook for health alerts.
BRAIN_ALERT_WEBHOOK=
# Sign-in from the Ambient iPhone and Mac apps ("Use your own server" on their sign-in screen).
# Empty: the App Store apps' bundle id, si.ambientartifacts.brain. "none": no Sign in with Apple
# (accounts then come only from `admin user add`). Your own build of the apps: its bundle id.
BRAIN_APPLE_AUDIENCES=
# Who can make an account by signing in from the apps. Empty or "none": only people you added
# with `admin user add` (matched by the email Apple confirms). A list such as "@acme.com,
# anna@gmail.com": those emails and domains too. "open": anyone who knows the server's address.
BRAIN_SIGNUPS=
# Continue with Microsoft: a Microsoft Entra app registration's client id. New Microsoft
# accounts need BRAIN_SIGNUPS=open (Microsoft doesn't vouch for emails in every tenant).
BRAIN_MICROSOFT_CLIENT_IDS=
# "Connect Microsoft 365" for team folders: your own multi-tenant Entra app (a web app, not the
# sign-in app) and its certificate (a PEM file with the private key and the certificate) or a
# client secret. Leave empty: teams connect their own Entra app instead.
BRAIN_MICROSOFT_CONNECT_CLIENT_ID=
BRAIN_MICROSOFT_CONNECT_CERT_FILE=
BRAIN_MICROSOFT_CONNECT_SECRET=
# Ports on 127.0.0.1 (this machine only).
GATEWAY_PORT=8080
CONVEX_PORT=3210
DASHBOARD_PORT=6791
# Images. AMBIENT_IMAGE is built from this checkout by default.
AMBIENT_IMAGE=ambient-platform:local
CONVEX_BACKEND_IMAGE=ghcr.io/convex/convex-backend:latest
CONVEX_DASHBOARD_IMAGE=ghcr.io/convex/convex-dashboard:latest
# Convex's anonymous usage ping from self-hosted backends (https://github.com/convex/convex-backend).
CONVEX_DISABLE_BEACON=true

# Team VM: only the gateway may call the team API (JWT-checked as well).
# No admin API: on localhost:2019 any local user (a routine, on team VMs) could rewrite the proxy.
# A new config takes a restart (deploy.sh falls back to one).
{
	admin off
}

__BRAIN_HOST__ {
	@gateway remote_ip __BRAIN_GATEWAY_IP__
	handle @gateway {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		respond "Forbidden" 403
	}
	header -Server
}

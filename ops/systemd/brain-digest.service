[Unit]
Description=Ambient morning push of open action items (in each user's time zone)
After=network-online.target
Wants=network-online.target
OnFailure=brain-notify@%n.service

[Service]
Type=oneshot
User=brain
Group=brain
WorkingDirectory=/opt/brain/app
EnvironmentFile=/etc/brain/gateway.env
ExecStart=/usr/bin/node --import tsx gateway/src/worker/cli.ts digest
TimeoutStartSec=20min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
